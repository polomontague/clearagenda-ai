// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  	provider = "prisma-client"
  	output   = "../generated/prisma"
}

datasource db {
  	provider = "mysql"
}

enum theme {
	light
	dark
	system
}

enum accent {
	red
	orange
	coral
	yellow
	lime
	green
	mint
	turquoise
	sky
	lavender
	pink
}

model users {
	id Int @id @default(autoincrement())
	tasks tasks[]
	events events[]
	reminders reminders[]
	generations generations[]
	first_name String @db.VarChar(30)
	last_name String @db.VarChar(60)
	email String @db.VarChar(100) @unique
	phone String @db.VarChar(11) @unique
	password String @db.VarChar(255)
	theme theme @default(light)
	accent accent @default(yellow)
	sunday_hours Int @default(8)
	monday_hours Int @default(8)
	tuesday_hours Int @default(8)
	wednesday_hours Int @default(8)
	thursday_hours Int @default(8)
	friday_hours Int @default(8)
	saturday_hours Int @default(8)
	created DateTime @default(now())
	updated DateTime @updatedAt
}

enum occurs {
	once
	repeating
}

model task_steps {
	id Int @id @default(autoincrement())
	task_id Int
	task tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)
	name String @db.VarChar(100)
	notes String? @db.VarChar(500)
	duration Int
	completed DateTime?
	completions task_step_completions[]
}

model task_step_completions {
	id Int @id @default(autoincrement())
	step_id Int
	step task_steps @relation(fields: [step_id], references: [id], onDelete: Cascade)
	date String
	completed DateTime
}

model tasks {
	id Int @id @default(autoincrement())
	occurs occurs
	user_id Int
	user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
	name String @db.VarChar(100)
	description String @db.Text
	steps task_steps[]
	importance Float
	once_deadline String?
	repeating_deadline Int?
	repeat Json?
	created DateTime @default(now())
	updated DateTime @updatedAt
}

model events {
	id Int @id @default(autoincrement())
	occurs occurs
	user_id Int
	user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
	name String @db.VarChar(100)
	notes String? @db.VarChar(300)
	duration Int
	timezone String @db.VarChar(30)
	once_starts DateTime?
	repeating_starts String?
	repeat Json?
	created DateTime @default(now())
	updated DateTime @updatedAt
}

model reminders {
	id Int @id @default(autoincrement())
	occurs occurs
	user_id Int
	user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
	name String @db.VarChar(100)
	once_at String?
	repeating_at String?
	repeat Json?
	created DateTime @default(now())
	updated DateTime @updatedAt
}

















enum item_type {
	task
	event
}

enum item_occurs {
	once
	repeating
}

model items {
	id Int @id @default(autoincrement())
	user_id Int
	// user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
	type item_type
	name String @db.VarChar(100)
	description String? @db.Text
	steps item_steps[]
	importance Float?
	notes String? @db.VarChar(300)
	starts DateTime?
	duration Int?
	occurs item_occurs
	deadline DateTime?
	repeat Json?
	timezone String? @db.VarChar(30)
	created DateTime @default(now())
	updated DateTime @updatedAt
}

model item_steps {
	id Int @id @default(autoincrement())
	item_id Int
	item items @relation(fields: [item_id], references: [id], onDelete: Cascade)
	name String @db.VarChar(100)
	notes String? @db.VarChar(500)
	duration Int
	completed DateTime?
}

model generations {
	id Int @id @default(autoincrement())
	user_id Int
	user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
	model String @db.VarChar(30)
	input_tokens Int
	output_tokens Int
	created DateTime @default(now())
}