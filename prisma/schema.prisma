// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  	provider = "prisma-client"
  	output   = "../generated/prisma"
}

datasource db {
  	provider = "mysql"
}

enum theme {
	light
	dark
	system
}

enum accent {
	red
	orange
	coral
	yellow
	lime
	green
	mint
	turquoise
	sky
	lavender
	pink
}

model users {
	id Int @id @default(autoincrement())
	items items[]
	first_name String @db.VarChar(30)
	last_name String @db.VarChar(60)
	email String @db.VarChar(100) @unique
	phone String @db.VarChar(11) @unique
	password String @db.VarChar(255)
	theme theme @default(light)
	accent accent @default(yellow)
	sunday_hours Int @default(8)
	monday_hours Int @default(8)
	tuesday_hours Int @default(8)
	wednesday_hours Int @default(8)
	thursday_hours Int @default(8)
	friday_hours Int @default(8)
	saturday_hours Int @default(8)
	created DateTime @default(now())
	updated DateTime @updatedAt
}

model tasks {
	id Int @id @default(autoincrement())
	user_id Int
	steps task_steps[]
	name String @db.VarChar(100)
	notes String? @db.VarChar(300)
	description String? @db.Text
	duration Int?
	deadline DateTime?
	importance Float
	created DateTime @default(now())
	updated DateTime @updatedAt
	completed DateTime?
}

model task_steps {
	id Int @id @default(autoincrement())
	task_id Int
	task tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)
	name String @db.VarChar(100)
	notes String @db.VarChar(300)
	duration Int
	completed DateTime?
}

model items {
	id Int @id @default(autoincrement())
	user_id Int
	user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
	name String @db.VarChar(100)
	description String @db.Text
	steps item_steps[]
	deadline DateTime?
	importance Float
	created DateTime @default(now())
	updated DateTime @updatedAt
}

model item_steps {
	id Int @id @default(autoincrement())
	item_id Int
	item items @relation(fields: [item_id], references: [id], onDelete: Cascade)
	name String @db.VarChar(100)
	notes String @db.VarChar(300)
	duration Int
	completed DateTime?
}